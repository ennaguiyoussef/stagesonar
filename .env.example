# Copier ce fichier en .env puis remplir les valeurs. Ne jamais pousser .env sur GitHub.

# Base de données
# Sans cette ligne, l'application utilise un fichier SQLite local (pratique pour démarrer).
# DATABASE_URL=postgresql+psycopg2://stagesonar:stagesonar@localhost:5432/stagesonar

# Pipeline
SCRAPE_INTERVAL_HOURS=6
MATCH_THRESHOLD=0.2
REQUEST_DELAY_SECONDS=2
USER_AGENT=StageSonarBot/0.1 (projet universitaire)

# E-mail (Gmail : créer un mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Adresse publique du frontend, utilisée dans les liens des e-mails
FRONTEND_URL=http://localhost:5173
